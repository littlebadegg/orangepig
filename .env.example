# Docker Compose 环境变量
# 复制为 .env 并填写真实值，Docker Compose 会自动读取

# 域名（Nginx server_name）
# 本地开发: localhost
# 生产环境: your-domain.com
DOMAIN=localhost

# MySQL 数据库
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=orangepig
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# JWT
JWT_SECRET=your-random-secret-key
JWT_EXPIRES_IN=7d

# 微信小程序
WX_APPID=your-appid
WX_SECRET=your-secret

# 静态资源访问地址
# 本地开发: http://localhost
# 生产环境: https://your-domain.com
STATIC_BASE_URL=http://localhost

# 图片最大大小（字节，默认 15MB）
MAX_FILE_SIZE=15728640
