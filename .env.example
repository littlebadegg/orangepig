# Docker Compose 环境变量
# 复制为 .env 并填写真实值，Docker Compose 会自动读取

# 域名（Nginx server_name）
# 本地开发: localhost
# 生产环境: your-domain.com
DOMAIN=localhost

# Nginx 对外端口
# 如果 80 端口被占用（如 Rancher），改用其他端口
# Rancher Ingress 转发到这个端口
NGINX_PORT=8080

# MySQL 数据库
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=orangepig
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# JWT
JWT_SECRET=your-random-secret-key
JWT_EXPIRES_IN=7d

# 微信小程序
WX_APPID=your-appid
WX_SECRET=your-secret

# 首次启动是否插入演示数据（宝宝「小橙子」+ 今日几条示例记录）
# 表结构每次启动都会自动同步，不需要手动初始化数据库
# 正式使用建议设为 false
SEED_DEMO=true
