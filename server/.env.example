# 环境变量配置 — 复制为 .env 并填写真实值

# 服务端口
PORT=3000

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=orangepig
DB_USER=root
DB_PASSWORD=

# 数据库连接池（可选，一般不用改）
# DB_POOL_MAX=10
# DB_POOL_MIN=0
# DB_POOL_ACQUIRE=30000
# DB_POOL_IDLE=10000

# JWT 密钥（生产环境请用随机长字符串）
JWT_SECRET=your-super-secret-key-change-me

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 微信小程序配置
WX_APPID=your-wechat-appid
WX_SECRET=your-wechat-secret

# 图片上传目录
UPLOAD_DIR=uploads

# 图片访问基础 URL（生产环境替换为你的域名）
# 开发环境：http://localhost:3000
# 生产环境：https://your-domain.com
STATIC_BASE_URL=http://localhost:3000

# 图片最大大小（字节，默认 5MB）
MAX_FILE_SIZE=5242880
