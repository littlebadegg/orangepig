/**
 * 全局样式 — 橙猪宝宝记
 * 温暖育儿风：暖橙主色 + 圆角卡片 + 大按钮
 */
page {
  background: #f6f7f9;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #222;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ===== 布局 ===== */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-1 {
  flex: 1;
}

/* ===== 卡片 ===== */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 20rpx;
}

/* ===== 文字 ===== */
.text-main {
  color: #222;
}

.text-sub {
  color: #888;
  font-size: 26rpx;
}

.text-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff7a45;
  line-height: 1.2;
}

.text-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 20rpx 32rpx;
  background: #f2f3f5;
  color: #666;
}

.btn-primary {
  background: #ff7a45;
  color: #fff;
  font-weight: 600;
}

.btn-block {
  width: 100%;
}

.btn-ghost {
  background: #fff;
  color: #ff7a45;
  border: 2rpx solid #ff7a45;
}

/* ===== 空状态 ===== */
.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

/* ===== 弹窗 ===== */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}

.sheet-close {
  position: absolute;
  right: 32rpx;
  top: 24rpx;
  font-size: 40rpx;
  color: #bbb;
  line-height: 1;
  padding: 8rpx;
}
