<!-- 发布内容页 -->
<view class="publish-page">
  <!-- 文字输入区 -->
  <textarea
    class="content-input"
    placeholder="分享你的想法..."
    placeholder-class="placeholder"
    maxlength="{{maxChars}}"
    value="{{content}}"
    bindinput="onContentInput"
    auto-height
    show-confirm-bar="{{false}}"
    adjust-position="{{true}}"
  ></textarea>

  <!-- 字数统计 -->
  <view class="char-count">
    <text>{{content.length}}/{{maxChars}}</text>
  </view>

  <!-- 图片选择区 -->
  <view class="image-grid">
    <block wx:for="{{images}}" wx:key="*this">
      <view class="image-item">
        <image
          src="{{item}}"
          mode="aspectFill"
          class="preview-image"
          data-url="{{item}}"
          bindtap="previewImage"
        ></image>
        <view class="delete-btn" data-index="{{index}}" catchtap="deleteImage">
          <text class="delete-icon">×</text>
        </view>
      </view>
    </block>

    <!-- 添加图片按钮 -->
    <view
      wx:if="{{images.length < maxImages}}"
      class="add-image"
      bindtap="chooseImage"
    >
      <text class="add-icon">+</text>
      <text class="add-text">{{images.length}}/{{maxImages}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar safe-bottom">
    <view class="cancel-btn" bindtap="onCancel">取消</view>
    <view
      class="submit-btn {{(content || images.length > 0) ? '' : 'disabled'}}"
      bindtap="onSubmit"
    >
      {{submitting ? '发布中...' : '发布'}}
    </view>
  </view>
</view>
