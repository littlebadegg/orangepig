.publish-page {
  min-height: 100vh;
  background: #fff;
  padding: 30rpx;
  padding-bottom: 160rpx;
}

.content-input {
  width: 100%;
  min-height: 240rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: #1a1a1a;
}

.placeholder {
  color: #ccc;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #ccc;
  margin: 10rpx 0 30rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 210rpx;
  height: 210rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
}

.add-image {
  width: 210rpx;
  height: 210rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 56rpx;
  color: #ddd;
  font-weight: 300;
}

.add-text {
  font-size: 22rpx;
  color: #aaa;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 0 30rpx;
}

.cancel-btn {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  color: #666;
}

.submit-btn {
  padding: 16rpx 60rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.submit-btn.disabled {
  opacity: 0.5;
}
