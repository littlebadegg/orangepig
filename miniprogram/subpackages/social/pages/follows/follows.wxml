<!-- 关注/粉丝列表页 -->
<view class="follows-page">
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && list.length === 0}}">
    <text class="empty-icon">{{type === 'following' ? '👤' : '👥'}}</text>
    <text class="empty-text">{{type === 'following' ? '还没有关注任何人' : '还没有粉丝'}}</text>
  </view>

  <!-- 列表 -->
  <view class="user-list" wx:if="{{list.length > 0}}">
    <view
      class="user-item"
      wx:for="{{list}}"
      wx:key="id"
      wx:for-index="idx"
    >
      <view
        class="user-info"
        data-user-id="{{item.id}}"
        bindtap="onTapUser"
      >
        <image
          class="user-avatar"
          src="{{item.avatarUrl || '/images/tab/mine.png'}}"
          mode="aspectFill"
        ></image>
        <view class="user-meta">
          <text class="user-name">{{item.nickName || '微信用户'}}</text>
          <text class="user-bio">{{item.bio || '这个人很懒'}}</text>
        </view>
      </view>

      <!-- 关注/已关注按钮（不显示自己的） -->
      <view
        class="follow-btn {{item.isFollowing ? 'followed' : ''}}"
        wx:if="{{item.id !== currentUserId}}"
        data-user-id="{{item.id}}"
        data-index="{{idx}}"
        bindtap="onToggleFollow"
      >
        {{item.isFollowing ? '已关注' : '+ 关注'}}
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!loading && !hasMore && list.length > 0}}">
    <text>没有更多了</text>
  </view>
</view>
