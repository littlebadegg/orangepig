/* 个人主页样式 */
.profile-page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 40rpx;
}

/* 用户信息 */
.profile-header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: #fff;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 24rpx;
}

.profile-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.profile-bio {
  font-size: 24rpx;
  color: #999;
}

.follow-action {
  padding: 14rpx 36rpx;
  background: #FF6B35;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.follow-action.followed {
  background: #f5f5f5;
  color: #999;
}

/* 统计 */
.profile-stats {
  display: flex;
  background: #fff;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 标题栏 */
.section-title-bar {
  padding: 30rpx 30rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 帖子列表 */
.post-list {
  padding: 0 30rpx;
}

.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.post-with-img {
  display: flex;
  align-items: flex-start;
}

.post-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.post-text-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 160rpx;
}

.post-text-only {
  display: flex;
  flex-direction: column;
}

.post-content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  flex: 1;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.post-time {
  font-size: 22rpx;
  color: #ccc;
}

.post-stats {
  font-size: 22rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #ccc;
}

/* 加载更多 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #ccc;
}
