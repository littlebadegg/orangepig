<!-- 个人主页 -->
<view class="profile-page" wx:if="{{userInfo}}">
  <!-- 用户信息 -->
  <view class="profile-header">
    <image
      class="profile-avatar"
      src="{{userInfo.avatarUrl || '/images/tab/mine.png'}}"
      mode="aspectFill"
    ></image>
    <view class="profile-meta">
      <text class="profile-name">{{userInfo.nickName || '微信用户'}}</text>
      <text class="profile-bio">{{userInfo.bio || '这个人很懒，什么都没留下'}}</text>
    </view>
    <!-- 关注按钮 -->
    <view
      class="follow-action {{isFollowing ? 'followed' : ''}}"
      wx:if="{{!isMine}}"
      bindtap="onToggleFollow"
    >
      {{isFollowing ? '已关注' : '+ 关注'}}
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="profile-stats">
    <view class="stat-item" data-type="following" bindtap="onTapFollow">
      <text class="stat-num">{{userInfo.followingCount || 0}}</text>
      <text class="stat-label">关注</text>
    </view>
    <view class="stat-item" data-type="followers" bindtap="onTapFollow">
      <text class="stat-num">{{userInfo.followersCount || 0}}</text>
      <text class="stat-label">粉丝</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{userInfo.postCount || 0}}</text>
      <text class="stat-label">发布</text>
    </view>
  </view>

  <!-- 发布内容 -->
  <view class="section-title-bar">
    <text class="section-title">发布内容</text>
  </view>

  <view class="post-list">
    <view
      class="post-card"
      wx:for="{{posts}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapPost"
    >
      <!-- 有图 -->
      <view class="post-with-img" wx:if="{{item.firstImage}}">
        <image
          class="post-thumb"
          src="{{item.firstImage}}"
          mode="aspectFill"
          lazy-load
        ></image>
        <view class="post-text-wrap">
          <text class="post-content-text">{{item.content || '(图片内容)'}}</text>
          <view class="post-meta">
            <text class="post-time">{{item.timeText}}</text>
            <text class="post-stats">❤ {{item.likeCountText}}  💬 {{item.commentCountText}}</text>
          </view>
        </view>
      </view>
      <!-- 纯文字 -->
      <view class="post-text-only" wx:else>
        <text class="post-content-text">{{item.content}}</text>
        <view class="post-meta">
          <text class="post-time">{{item.timeText}}</text>
          <text class="post-stats">❤ {{item.likeCountText}}  💬 {{item.commentCountText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && posts.length === 0}}">
    <text class="empty-icon">📝</text>
    <text class="empty-text">{{isMine ? '还没有发布过内容' : 'TA还没有发布内容'}}</text>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!loading && !hasMore && posts.length > 0}}">
    <text>没有更多了</text>
  </view>
</view>
