<view class="page">

  <!-- ===== 游客模式 ===== -->
  <view class="card" wx:if="{{guest}}" style="align-items: center;">
    <text class="empty-icon">📊</text>
    <text>登录后可查看宝宝的生长数据统计</text>
    <view class="btn btn-primary go-btn" bindtap="goLogin">微信一键登录</view>
  </view>

  <view class="baby-bar" wx:if="{{!guest}}">
    <view class="row">
      <view class="baby-avatar">📊</view>
      <view class="col baby-meta">
        <text class="baby-name">{{currentBaby ? currentBaby.name : '还没有宝宝'}}</text>
        <text class="baby-sub">生长数据统计</text>
      </view>
    </view>
  </view>

  <!-- ===== 今日 ===== -->
  <view class="card" wx:if="{{stats}}">
    <view class="card-title">今日</view>

    <view class="stat-row">
      <text class="stat-icon">🍼</text>
      <view class="col stat-main">
        <text class="stat-label">喂养</text>
        <text class="stat-sub">奶粉 {{stats.feeding.formulaCount}} 次 · 母乳 {{stats.feeding.breastCount}} 次</text>
      </view>
      <text class="stat-value">{{stats.feeding.totalAmount}} ml</text>
    </view>

    <view class="divider"></view>

    <view class="stat-row">
      <text class="stat-icon">🧷</text>
      <view class="col stat-main">
        <text class="stat-label">换尿片</text>
        <text class="stat-sub">大便 {{stats.diaper.pooCount}} 次 · 小便 {{stats.diaper.peeCount}} 次</text>
      </view>
      <text class="stat-value">{{stats.diaper.count}} 次</text>
    </view>

    <view class="divider"></view>

    <view class="stat-row">
      <text class="stat-icon">😴</text>
      <view class="col stat-main">
        <text class="stat-label">睡眠</text>
        <text class="stat-sub">共 {{stats.sleep.count}} 次{{stats.sleep.isSleeping ? ' · 睡眠中' : ''}}</text>
      </view>
      <text class="stat-value">{{stats.sleep.totalText}}</text>
    </view>

    <view class="divider"></view>

    <view class="stat-row">
      <text class="stat-icon">🤸</text>
      <view class="col stat-main">
        <text class="stat-label">排气操</text>
        <text class="stat-sub">
          {{stats.exercise.count > 0 ? '共 ' + stats.exercise.minutesText + (stats.exercise.lastText ? ' · 上次 ' + stats.exercise.lastText : '') : '今天还没做'}}
        </text>
      </view>
      <text class="stat-value">{{stats.exercise.count}} 次</text>
    </view>

    <view class="divider"></view>

    <view class="stat-row">
      <text class="stat-icon">{{stats.temperature.isFever ? '🤒' : '🌡️'}}</text>
      <view class="col stat-main">
        <text class="stat-label">体温</text>
        <text class="stat-sub">
          {{stats.temperature.count > 0 ? '今日 ' + stats.temperature.count + ' 次 · ' + stats.temperature.levelText + (stats.temperature.timeText ? ' · 最近 ' + stats.temperature.timeText : '') : '今天还没测'}}
        </text>
      </view>
      <text class="stat-value {{stats.temperature.isFever ? 'stat-value-warn' : ''}}">{{stats.temperature.latestText || '—'}}</text>
    </view>

    <view class="divider"></view>

    <view class="stat-row">
      <text class="stat-icon">🤮</text>
      <view class="col stat-main">
        <text class="stat-label">吐奶</text>
        <text class="stat-sub">
          {{stats.spitUp.count > 0 ? '今日 ' + stats.spitUp.count + ' 次' + (stats.spitUp.lastText ? ' · 最近 ' + stats.spitUp.lastText + ' ' + stats.spitUp.lastLevelText : '') : '今天没吐奶，很好'}}
        </text>
      </view>
      <text class="stat-value">{{stats.spitUp.count}} 次</text>
    </view>

    <view class="divider"></view>

    <view class="stat-row">
      <text class="stat-icon">🛁</text>
      <view class="col stat-main">
        <text class="stat-label">洗澡</text>
        <text class="stat-sub">
          {{stats.bath.count > 0 ? '今日 ' + stats.bath.count + ' 次 · ' + stats.bath.minutesText + (stats.bath.lastWaterTemp ? ' · 水温 ' + stats.bath.lastWaterTemp + '℃' : '') : '今天还没洗'}}
        </text>
      </view>
      <text class="stat-value">{{stats.bath.count}} 次</text>
    </view>

    <view class="avg-tip" wx:if="{{stats.feeding.formulaCount > 0}}">
      平均每餐 {{stats.feeding.avgAmount}}ml
    </view>
  </view>

  <!-- ===== 身高体重 ===== -->
  <view class="card" wx:if="{{stats && stats.growth.hasData}}">
    <view class="card-title">最近一次测量</view>
    <view class="growth-row">
      <view class="growth-item">
        <text class="growth-value">{{stats.growth.heightText || '—'}}</text>
        <text class="growth-label">📏 身高</text>
      </view>
      <view class="growth-item">
        <text class="growth-value">{{stats.growth.weightText || '—'}}</text>
        <text class="growth-label">⚖️ 体重</text>
      </view>
    </view>
    <view class="avg-tip" wx:if="{{stats.growth.measuredText}}">测量于 {{stats.growth.measuredText}}</view>
  </view>

  <!-- ===== 近 N 天奶量 ===== -->
  <view class="card" wx:if="{{trend.length > 0}}">
    <view class="card-title">近 {{days}} 天奶量</view>
    <view class="trend-row" wx:for="{{trend}}" wx:key="date">
      <text class="trend-date">{{item.label}}</text>
      <view class="trend-bar-wrap">
        <view class="trend-bar" style="width: {{item.barWidth}}%"></view>
      </view>
      <text class="trend-num">{{item.totalAmount}}ml</text>
    </view>
  </view>

  <!-- ===== 每日明细 ===== -->
  <view class="card" wx:if="{{trend.length > 0}}">
    <view class="card-title">每日明细</view>
    <view class="detail-row detail-head">
      <text class="d-date">日期</text>
      <text class="d-item">喂养</text>
      <text class="d-item">尿片</text>
      <text class="d-item">睡眠</text>
    </view>
    <view class="detail-row" wx:for="{{trend}}" wx:key="date">
      <text class="d-date">{{item.label}}</text>
      <text class="d-item">{{item.feedingCount}} 次</text>
      <text class="d-item">{{item.diaperCount}} 次</text>
      <text class="d-item">{{item.sleepText || '—'}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!guest && !stats}}">
    <text class="empty-icon">📊</text>
    <text>还没有数据，先去记录一条吧</text>
    <view class="btn btn-primary go-btn" bindtap="goRecord">去记录</view>
  </view>

</view>
