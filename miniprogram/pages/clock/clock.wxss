/* ===== 24 小时时钟盘 ===== */
.page {
  padding-bottom: 60rpx;
}

/* 顶部宝宝栏 */
.baby-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #ffa25c, #ff7a45);
  padding: 36rpx 32rpx 48rpx;
  color: #fff;
}

.baby-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.baby-name {
  font-size: 36rpx;
  font-weight: 600;
}

.baby-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.switch-btn {
  background: rgba(255, 255, 255, 0.22);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 日期切换 */
.date-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.date-nav {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 40rpx;
  color: #ff7a45;
}

.date-nav-off {
  color: #ddd;
}

.date-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 圆盘 */
.clock-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 4rpx;
}

.clock-canvas {
  width: 620rpx;
  height: 620rpx;
}

/* 覆盖度 */
.coverage-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 8rpx;
}

.coverage-main {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.coverage-sub {
  font-size: 24rpx;
  color: #999;
}

.coverage-bar {
  height: 12rpx;
  background: #f2f3f5;
  border-radius: 6rpx;
  overflow: hidden;
  margin-top: 14rpx;
}

.coverage-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffb37a, #ff7a45);
  border-radius: 6rpx;
}

.coverage-note {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #b08968;
}

.active-tip {
  margin-top: 18rpx;
  background: #fff7f1;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #8a5b33;
  line-height: 1.5;
}

.tap-hint {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #c4c4c4;
}

/* 图例 */
.legend-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.legend-item {
  width: 50%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 0;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.legend-main {
  flex: 1;
}

.legend-label {
  font-size: 26rpx;
  color: #333;
}

.legend-sub {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 2rpx;
}

.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.6;
}

/* 时间轴 */
.tl-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.tl-row:last-child {
  border-bottom: none;
}

.tl-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tl-time {
  width: 190rpx;
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.tl-title {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.tl-dur {
  font-size: 24rpx;
  color: #ff9a5c;
  margin-left: 12rpx;
}

/* 空态 / 游客 */
.guest-card {
  align-items: center;
  padding: 60rpx 40rpx;
}

.guest-card text {
  font-size: 28rpx;
  color: #8a5b33;
  text-align: center;
  line-height: 1.7;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  color: #aaa;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.go-btn {
  margin-top: 24rpx;
  width: 240rpx;
}
