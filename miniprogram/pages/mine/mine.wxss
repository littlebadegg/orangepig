/* ===== 我的 ===== */
.page {
  padding-bottom: 60rpx;
}

.user-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: linear-gradient(135deg, #ffa25c, #ff7a45);
  padding: 40rpx 32rpx 56rpx;
  color: #fff;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
}

.user-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.add-btn {
  font-size: 26rpx;
  color: #ff7a45;
  padding: 8rpx 20rpx;
  background: #fff3ec;
  border-radius: 24rpx;
}

.baby-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.baby-item:last-child {
  border-bottom: none;
}

.baby-current {
  background: #fff8f2;
}

.baby-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.baby-emoji {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.baby-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.current-tag {
  font-size: 20rpx;
  color: #ff7a45;
  background: #ffe8d9;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.baby-item-sub {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 4rpx;
}

.baby-ops {
  display: flex;
  flex-direction: row;
}

.baby-op {
  font-size: 26rpx;
  color: #888;
  padding: 10rpx 20rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  margin-left: 12rpx;
}

.baby-op-del {
  color: #e54545;
  background: #fff1f0;
}

.tip-line {
  display: block;
  font-size: 26rpx;
  color: #888;
  line-height: 1.9;
}

.go-btn {
  margin: 30rpx auto 0;
  width: 260rpx;
}

/* 弹窗控件 */
.sheet-label {
  font-size: 26rpx;
  color: #888;
  margin: 20rpx 0 14rpx;
}

.input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.picker {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #333;
}

.sheet-btn {
  margin-top: 32rpx;
  padding: 26rpx 0;
  font-size: 32rpx;
}
