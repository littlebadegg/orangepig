/* 我的页面样式 */
.mine-page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.profile-card {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
}

.avatar-wrap {
  margin-right: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background: #fff;
}

.user-meta {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.bio {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 数据统计栏 */
.stats-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #eee;
}

/* 菜单列表 */
.menu-list {
  margin-top: 20rpx;
  background: #fff;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  width: 60rpx;
  text-align: center;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  margin-left: 16rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}
