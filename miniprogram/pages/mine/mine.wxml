<view class="page">

  <!-- ===== 头部 ===== -->
  <view class="user-bar">
    <view class="user-avatar">🐷</view>
    <view class="col">
      <text class="user-name">橙猪宝宝记</text>
      <text class="user-sub">记录宝宝每一次成长</text>
    </view>
  </view>

  <!-- ===== 宝宝列表 ===== -->
  <view class="card">
    <view class="row-between">
      <text class="card-title">我的宝宝</text>
      <view class="row">
        <text class="add-btn" bindtap="openJoin">+ 加入家人宝宝</text>
        <text class="add-btn add-btn-main" bindtap="openAdd">+ 添加</text>
      </view>
    </view>

    <view class="empty" wx:if="{{babies.length === 0}}">
      <text class="empty-icon">👶</text>
      <text>还没有添加宝宝</text>
      <view class="btn btn-primary go-btn" bindtap="openAdd">添加宝宝</view>
      <view class="btn go-btn" bindtap="openJoin">用邀请码加入</view>
    </view>

    <view class="baby-item {{item.id === currentBabyId ? 'baby-current' : ''}}" wx:for="{{babies}}" wx:key="id">
      <view class="baby-left" data-id="{{item.id}}" bindtap="onSelectBaby">
        <text class="baby-emoji">👶</text>
        <view class="col">
          <view class="row">
            <text class="baby-item-name">{{item.name}}</text>
            <text class="current-tag" wx:if="{{item.id === currentBabyId}}">当前</text>
            <text class="role-tag" wx:if="{{item.role === 'member'}}">家人共享</text>
          </view>
          <text class="baby-item-sub">{{item.genderText}} · {{item.birthday || '未设置生日'}}</text>
          <text class="baby-item-family">我是宝宝的{{item.myRelationText || '家人'}}</text>
          <text class="baby-item-family" wx:if="{{item.memberCount > 1}}">👨‍👩‍👧 {{item.memberCount}} 人一起记录</text>
        </view>
      </view>
      <view class="baby-ops">
        <block wx:if="{{item.isOwner}}">
          <text class="baby-op" data-id="{{item.id}}" data-name="{{item.name}}" data-gender="{{item.gender}}" data-birthday="{{item.birthday}}" data-relation="{{item.myRelation}}" bindtap="openEdit">编辑</text>
          <text class="baby-op" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="openFamily">家人</text>
          <text class="baby-op baby-op-del" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onDeleteBaby">删除</text>
        </block>
        <block wx:else>
          <text class="baby-op" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="openFamily">家人</text>
          <text class="baby-op baby-op-del" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onLeaveBaby">退出</text>
        </block>
      </view>
    </view>
  </view>

  <!-- ===== 小贴士 ===== -->
  <view class="card">
    <text class="card-title">使用小贴士</text>
    <text class="tip-line">🍼 喂奶 — 支持「奶粉毫升」和「母乳时长」两种记法</text>
    <text class="tip-line">🛁 洗澡 / 🤮 吐奶 — 都在首页一键记录</text>
    <text class="tip-line">👨‍👩‍👧 家人共享 — 点「家人」生成邀请码，家人加入后各记各的，数据实时同步</text>
    <text class="tip-line">✏️ 点一条记录可以修改，右侧叉号删除</text>
  </view>

  <!-- ===== 账号 ===== -->
  <view class="card">
    <view class="row-between">
      <text class="card-title">账号</text>
      <text class="text-sub">微信登录</text>
    </view>
    <view class="agree-entry" bindtap="openUserAgreement">
      <text>用户服务协议</text>
      <text class="agree-arrow">›</text>
    </view>
    <view class="agree-entry" bindtap="openPrivacyAgreement">
      <text>隐私政策</text>
      <text class="agree-arrow">›</text>
    </view>
    <view class="btn btn-block logout-btn" bindtap="onLogout">退出登录</view>
  </view>

  <!-- ===== 添加/编辑弹窗 ===== -->
  <view class="mask" wx:if="{{showSheet}}" bindtap="closeSheet"></view>
  <view class="sheet" wx:if="{{showSheet}}">
    <view class="sheet-title">{{editingId ? '编辑宝宝' : '添加宝宝'}}</view>
    <view class="sheet-close" bindtap="closeSheet">✕</view>

    <view class="sheet-label">昵称</view>
    <input class="input" placeholder="给宝宝起个名字" value="{{babyName}}" bindinput="onNameInput" maxlength="20" />

    <view class="sheet-label">性别</view>
    <picker mode="selector" range="{{genderOptions}}" value="{{babyGender}}" bindchange="onGenderChange">
      <view class="picker">{{genderOptions[babyGender]}}</view>
    </picker>

    <view class="sheet-label">生日</view>
    <picker mode="date" value="{{babyBirthday}}" bindchange="onBirthdayChange">
      <view class="picker">{{babyBirthday || '请选择（可不填）'}}</view>
    </picker>

    <view class="sheet-label">你是宝宝的</view>
    <picker mode="selector" range="{{relationOptions}}" value="{{myRelationIndex}}" bindchange="onMyRelationChange">
      <view class="picker">{{relationOptions[myRelationIndex]}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitBaby">{{editingId ? '保存' : '添加'}}</view>
  </view>

  <!-- ===== 家人弹窗 ===== -->
  <view class="mask" wx:if="{{showFamily}}" bindtap="closeFamily"></view>
  <view class="sheet" wx:if="{{showFamily}}">
    <view class="sheet-title">{{familyBabyName}} · 一起记录</view>
    <view class="sheet-close" bindtap="closeFamily">✕</view>

    <block wx:if="{{familyIsOwner}}">
      <view class="invite-box">
        <text class="invite-label">家庭邀请码</text>
        <text class="invite-code">{{inviteCode || '生成中…'}}</text>
        <view class="row invite-ops">
          <view class="btn btn-ghost invite-btn" bindtap="copyCode">复制邀请码</view>
          <button class="btn btn-primary invite-btn" open-type="share">转发给家人</button>
        </view>
        <text class="invite-tip">家人在微信里打开卡片，确认后就能一起记录和查看</text>
      </view>
    </block>
    <block wx:else>
      <view class="invite-box">
        <text class="invite-tip">你是由创建者邀请加入的家人，可以记录和查看宝宝的全部数据。</text>
      </view>
    </block>

    <view class="sheet-label">家庭成员（{{members.length}}）</view>
    <view class="member-item" wx:for="{{members}}" wx:key="userId">
      <text class="member-avatar">{{item.role === 'owner' ? '👑' : '🙋'}}</text>
      <view class="col member-main">
        <text class="member-name">{{item.name}}<text class="member-self" wx:if="{{item.isSelf}}">（我）</text></text>
        <text class="member-sub">{{item.role === 'owner' ? '创建者' : '家人'}}{{item.relation ? ' · ' + item.relation : ''}}</text>
      </view>
      <block wx:if="{{item.isSelf}}">
        <picker mode="selector" range="{{relationOptions}}" data-uid="{{item.userId}}" data-relation="{{item.relation}}" bindchange="onMyRelationEdit">
          <text class="member-op member-op-edit">改称呼</text>
        </picker>
      </block>
      <text class="member-op" wx:if="{{familyIsOwner && !item.isSelf}}" data-uid="{{item.userId}}" data-name="{{item.name}}" bindtap="onRemoveMember">移除</text>
    </view>

    <view class="btn btn-block leave-btn" wx:if="{{!familyIsOwner}}" bindtap="onLeaveFromSheet">退出这个宝宝</view>
  </view>

  <!-- ===== 加入宝宝弹窗 ===== -->
  <view class="mask" wx:if="{{showJoin}}" bindtap="closeJoin"></view>
  <view class="sheet" wx:if="{{showJoin}}">
    <view class="sheet-title">加入家人的宝宝</view>
    <view class="sheet-close" bindtap="closeJoin">✕</view>

    <view class="sheet-label">邀请码</view>
    <input class="input input-code" placeholder="请输入 6 位邀请码" value="{{joinCode}}" bindinput="onJoinCodeInput" maxlength="6" />

    <view class="sheet-label">你是宝宝的</view>
    <picker mode="selector" range="{{relationOptions}}" value="{{joinRelationIndex}}" bindchange="onJoinRelationChange">
      <view class="picker">{{relationOptions[joinRelationIndex]}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitJoin">加入</view>
  </view>

</view>
