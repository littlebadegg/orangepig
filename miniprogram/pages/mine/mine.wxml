<!-- 我的页面 -->
<view class="mine-page">
  <!-- 用户信息卡片 -->
  <view class="profile-card">
    <view class="avatar-wrap">
      <image
        class="avatar"
        src="{{userInfo.avatarUrl || '/images/tab/mine.png'}}"
        mode="aspectFill"
      ></image>
    </view>
    <view class="user-meta" wx:if="{{isLogin}}">
      <text class="nickname">{{userInfo.nickName || '微信用户'}}</text>
      <text class="bio">{{userInfo.bio || '这个人很懒，什么都没留下'}}</text>
    </view>
    <view class="user-meta" wx:else>
      <text class="nickname">未登录</text>
      <text class="bio">点击登录享受更多功能</text>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-bar" wx:if="{{isLogin}}">
    <view class="stat-item" data-type="following" bindtap="onTapFollow">
      <text class="stat-num">{{stats.followingCount}}</text>
      <text class="stat-label">关注</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" data-type="followers" bindtap="onTapFollow">
      <text class="stat-num">{{stats.followersCount}}</text>
      <text class="stat-label">粉丝</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onTapMenu" data-key="posts">
      <text class="stat-num">{{stats.postCount}}</text>
      <text class="stat-label">发布</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onTapMenu" data-key="album">
      <text class="stat-num">{{stats.photoCount}}</text>
      <text class="stat-label">照片</text>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-list">
    <view
      wx:for="{{menuList}}"
      wx:key="key"
      class="menu-item"
      data-key="{{item.key}}"
      bindtap="onTapMenu"
    >
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-label">{{item.label}}</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="onTapSettings">
      <text class="menu-icon">⚙</text>
      <text class="menu-label">设置</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>
