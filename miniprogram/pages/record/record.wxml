<view class="page">

  <!-- ===== 宝宝栏 ===== -->
  <view class="baby-bar">
    <view class="row">
      <view class="baby-avatar">👶</view>
      <view class="col baby-meta">
        <text class="baby-name">{{currentBaby ? currentBaby.name : '还没有宝宝'}}</text>
        <text class="baby-sub">{{babySubtitle}}</text>
      </view>
    </view>
    <view class="switch-btn" bindtap="onSwitchBaby">切换</view>
  </view>

  <!-- ===== 一键记录 ===== -->
  <view class="card">
    <view class="row-between">
      <text class="card-title">一键记录</text>
      <text class="score-link" wx:if="{{stats && stats.score}}" bindtap="goScore">今日评分 {{stats.score.total}} 分 · {{stats.score.level}} ›</text>
    </view>
    <view class="actions">
      <view class="action action-feed" hover-class="action-hover" bindtap="openFeeding">
        <text class="action-icon">🍼</text>
        <text class="action-label">喂奶</text>
      </view>
      <view class="action action-diaper" hover-class="action-hover" bindtap="openDiaper">
        <text class="action-icon">🧷</text>
        <text class="action-label">换尿片</text>
      </view>
      <view class="action action-sleep {{ongoing ? 'action-active' : ''}}" hover-class="action-hover" bindtap="onSleepTap">
        <text class="action-icon">{{ongoing ? '🌞' : '😴'}}</text>
        <text class="action-label">{{ongoing ? '起床' : '睡觉'}}</text>
      </view>
      <view class="action action-spitup" hover-class="action-hover" bindtap="openSpitUp">
        <text class="action-icon">🤮</text>
        <text class="action-label">吐奶</text>
      </view>
    </view>
    <view class="actions actions-more">
      <view class="action action-bath" hover-class="action-hover" bindtap="openBath">
        <text class="action-icon">🛁</text>
        <text class="action-label">洗澡</text>
      </view>
      <view class="action action-exercise" hover-class="action-hover" bindtap="openExercise">
        <text class="action-icon">🤸</text>
        <text class="action-label">排气操</text>
      </view>
      <view class="action action-growth" hover-class="action-hover" bindtap="openGrowth">
        <text class="action-icon">📏</text>
        <text class="action-label">身高体重</text>
      </view>
      <view class="action action-temp" hover-class="action-hover" bindtap="openTemperature">
        <text class="action-icon">🌡️</text>
        <text class="action-label">体温</text>
      </view>
    </view>
    <view class="sleeping-tip" wx:if="{{ongoing}}">
      宝宝 {{ongoing.startText}} 入睡 · 已睡 {{sleepElapsed}}
    </view>
  </view>

  <!-- ===== 今日概览 ===== -->
  <view class="card" wx:if="{{stats}}">
    <view class="card-title">今日概览</view>
    <view class="overview">
      <view class="ov-item">
        <view class="row">
          <text class="text-num">{{stats.feeding.count}}</text>
          <text class="text-unit">次</text>
        </view>
        <text class="ov-label">🍼 共 {{stats.feeding.totalAmount}}ml</text>
      </view>
      <view class="ov-item">
        <view class="row">
          <text class="text-num">{{stats.diaper.count}}</text>
          <text class="text-unit">次</text>
        </view>
        <text class="ov-label">🧷 便{{stats.diaper.pooCount}} 尿{{stats.diaper.peeCount}}</text>
      </view>
      <view class="ov-item">
        <view class="row">
          <text class="text-num">{{stats.sleep.count}}</text>
          <text class="text-unit">次</text>
        </view>
        <text class="ov-label">😴 {{stats.sleep.totalText}}</text>
      </view>
    </view>
    <view class="last-tip" wx:if="{{stats.feeding.lastFeeding}}">
      <text class="tip-icon">🍼</text>
      <view class="tip-main">
        <text class="tip-ago">距上次喂养 {{stats.feeding.lastFeeding.agoText}}</text>
        <text class="tip-detail">{{stats.feeding.lastFeeding.timeText}} · {{stats.feeding.lastFeeding.title}}</text>
      </view>
    </view>
    <view class="last-tip {{stats.diaper.lastDiaper.minutes >= 180 ? 'last-tip-warn' : ''}}" wx:if="{{stats.diaper.lastDiaper}}">
      <text class="tip-icon">🧷</text>
      <view class="tip-main">
        <text class="tip-ago">距上次换尿片 {{stats.diaper.lastDiaper.agoText}}</text>
        <text class="tip-detail">{{stats.diaper.lastDiaper.timeText}} · {{stats.diaper.lastDiaper.typeText}}</text>
      </view>
    </view>

    <!-- 第二行：排气操 / 吐奶 / 洗澡 / 体温 -->
    <view class="overview overview-sub" wx:if="{{stats && (stats.exercise.count || stats.spitUp.count || stats.bath.count || stats.temperature.count)}}">
      <view class="ov-item">
        <view class="row">
          <text class="text-num">{{stats.exercise.count}}</text>
          <text class="text-unit">次</text>
        </view>
        <text class="ov-label">🤸 {{stats.exercise.minutesText || '—'}}</text>
      </view>
      <view class="ov-item">
        <view class="row">
          <text class="text-num">{{stats.spitUp.count}}</text>
          <text class="text-unit">次</text>
        </view>
        <text class="ov-label">🤮 {{stats.spitUp.lastLevelText || '没吐奶'}}</text>
      </view>
      <view class="ov-item">
        <view class="row">
          <text class="text-num">{{stats.bath.count}}</text>
          <text class="text-unit">次</text>
        </view>
        <text class="ov-label">🛁 {{stats.bath.minutesText || '—'}}</text>
      </view>
      <view class="ov-item">
        <text class="text-num text-sm">{{stats.temperature.latestText || '—'}}</text>
        <text class="ov-label">🌡️ {{stats.temperature.levelText}}</text>
      </view>
    </view>

    <!-- 第三行：最近一次身高体重 -->
    <view class="growth-line" wx:if="{{stats && stats.growth.hasData}}">
      <text class="growth-item">📏 {{stats.growth.heightText || '—'}}</text>
      <text class="growth-item">⚖️ {{stats.growth.weightText || '—'}}</text>
      <text class="growth-date" wx:if="{{stats.growth.measuredText}}">{{stats.growth.measuredText}}</text>
    </view>
  </view>

  <!-- ===== 今日记录 ===== -->
  <view class="card">
    <view class="row-between">
      <text class="card-title">今日记录</text>
      <text class="text-sub">{{list.length}} 条</text>
    </view>

    <view class="empty" wx:if="{{list.length === 0}}">
      <text class="empty-icon">📝</text>
      <text>今天还没有记录，点上面的按钮记一条</text>
    </view>

    <view class="record-item" wx:for="{{list}}" wx:key="key" wx:if="{{showAllRecords || index < 5}}" data-kind="{{item.kind}}" data-id="{{item.id}}" bindtap="onEditRecord" hover-class="record-hover">
      <view class="record-icon">{{item.icon}}</view>
      <view class="col record-main">
        <text class="record-title">{{item.title}}</text>
        <text class="record-sub" wx:if="{{item.kind === 'sleep'}}">{{item.subtitle}}</text>
        <text class="record-sub" wx:if="{{item.note}}">{{item.note}}</text>
        <text class="record-by" wx:if="{{item.recorder}}">{{item.recorder}}记的</text>
      </view>
      <text class="record-time">{{item.timeText}}</text>
      <view class="record-del" data-kind="{{item.kind}}" data-id="{{item.id}}" catchtap="onDeleteRecord">✕</view>
    </view>

    <!-- 折叠/展开 -->
    <view class="record-toggle" wx:if="{{list.length > 5}}" bindtap="onToggleRecords">
      {{showAllRecords ? '收起' : '展开全部 ' + list.length + ' 条'}}
      <text class="toggle-arrow">{{showAllRecords ? '↑' : '↓'}}</text>
    </view>
  </view>

  <!-- ===== 喂奶弹窗 ===== -->
  <view class="mask" wx:if="{{showFeeding}}" bindtap="closeFeeding"></view>
  <view class="sheet" wx:if="{{showFeeding}}">
    <view class="sheet-title">记录喂奶</view>
    <view class="sheet-close" bindtap="closeFeeding">✕</view>

    <view class="seg">
      <view class="seg-item {{feedingType === 'formula' ? 'seg-active' : ''}}" data-type="formula" bindtap="setFeedingType">奶粉</view>
      <view class="seg-item {{feedingType === 'breast' ? 'seg-active' : ''}}" data-type="breast" bindtap="setFeedingType">母乳</view>
    </view>

    <block wx:if="{{feedingType === 'formula'}}">
      <view class="sheet-label">奶量（ml）</view>
      <view class="chips">
        <view class="chip {{amount === item && !customAmount ? 'chip-active' : ''}}" wx:for="{{amountPresets}}" wx:key="*this" data-value="{{item}}" bindtap="setAmount">{{item}}</view>
      </view>
      <input class="input" type="number" placeholder="或输入自定义毫升数" value="{{customAmount}}" bindinput="onAmountInput" />
    </block>

    <block wx:else>
      <view class="sheet-label">喂奶时长（分钟）</view>
      <view class="chips">
        <view class="chip {{duration === item ? 'chip-active' : ''}}" wx:for="{{durationPresets}}" wx:key="*this" data-value="{{item}}" bindtap="setDuration">{{item}}</view>
      </view>
    </block>

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitFeeding">{{editingId ? '保存修改' : '确定记录'}}</view>
  </view>

  <!-- ===== 换尿片弹窗 ===== -->
  <view class="mask" wx:if="{{showDiaper}}" bindtap="closeDiaper"></view>
  <view class="sheet" wx:if="{{showDiaper}}">
    <view class="sheet-title">记录换尿片</view>
    <view class="sheet-close" bindtap="closeDiaper">✕</view>

    <view class="diaper-options">
      <view class="diaper-opt {{diaperType === 'pee' ? 'diaper-active' : ''}}" data-type="pee" bindtap="setDiaperType">
        <text class="diaper-emoji">💧</text>
        <text>小便</text>
      </view>
      <view class="diaper-opt {{diaperType === 'poo' ? 'diaper-active' : ''}}" data-type="poo" bindtap="setDiaperType">
        <text class="diaper-emoji">💩</text>
        <text>大便</text>
      </view>
      <view class="diaper-opt {{diaperType === 'both' ? 'diaper-active' : ''}}" data-type="both" bindtap="setDiaperType">
        <text class="diaper-emoji">💩💧</text>
        <text>都有</text>
      </view>
    </view>

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitDiaper">{{editingId ? '保存修改' : '确定记录'}}</view>
  </view>

  <!-- ===== 排气操弹窗 ===== -->
  <view class="mask" wx:if="{{showExercise}}" bindtap="closeExercise"></view>
  <view class="sheet" wx:if="{{showExercise}}">
    <view class="sheet-title">记录排气操</view>
    <view class="sheet-close" bindtap="closeExercise">✕</view>

    <view class="sheet-label">做了多久（分钟）</view>
    <view class="chips">
      <view class="chip {{exerciseDuration === item ? 'chip-active' : ''}}" wx:for="{{exercisePresets}}" wx:key="*this" data-value="{{item}}" bindtap="setExerciseDuration">{{item}}</view>
    </view>

    <view class="sheet-label">有排气 / 打嗝吗</view>
    <view class="seg">
      <view class="seg-item {{exerciseResult === 1 ? 'seg-active' : ''}}" data-value="1" bindtap="setExerciseResult">有</view>
      <view class="seg-item {{exerciseResult === 2 ? 'seg-active' : ''}}" data-value="2" bindtap="setExerciseResult">没有</view>
      <view class="seg-item {{exerciseResult === 0 ? 'seg-active' : ''}}" data-value="0" bindtap="setExerciseResult">不记</view>
    </view>

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitExercise">{{editingId ? '保存修改' : '确定记录'}}</view>
  </view>

  <!-- ===== 身高体重弹窗 ===== -->
  <view class="mask" wx:if="{{showGrowth}}" bindtap="closeGrowth"></view>
  <view class="sheet" wx:if="{{showGrowth}}">
    <view class="sheet-title">记录身高体重</view>
    <view class="sheet-close" bindtap="closeGrowth">✕</view>

    <view class="sheet-tip">两个都填或只填一个都可以</view>

    <view class="sheet-label">身高（cm）</view>
    <input class="input" type="digit" placeholder="例如 64.0" value="{{height}}" bindinput="onHeightInput" />

    <view class="sheet-label">体重（kg）</view>
    <input class="input" type="digit" placeholder="例如 7.2" value="{{weight}}" bindinput="onWeightInput" />

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitGrowth">{{editingId ? '保存修改' : '确定记录'}}</view>
  </view>

  <!-- ===== 体温弹窗 ===== -->
  <view class="mask" wx:if="{{showTemperature}}" bindtap="closeTemperature"></view>
  <view class="sheet" wx:if="{{showTemperature}}">
    <view class="sheet-title">记录体温</view>
    <view class="sheet-close" bindtap="closeTemperature">✕</view>

    <view class="sheet-label">体温（℃）</view>
    <view class="chips">
      <view class="chip {{temperature === item && !customTemperature ? 'chip-active' : ''}}" wx:for="{{tempPresets}}" wx:key="*this" data-value="{{item}}" bindtap="setTemperature">{{item}}</view>
    </view>
    <input class="input" type="digit" placeholder="或输入精确体温，例如 36.9" value="{{customTemperature}}" bindinput="onTempInput" />

    <view class="sheet-label">测量方式</view>
    <view class="seg">
      <view class="seg-item {{tempMethod === item.value ? 'seg-active' : ''}}" wx:for="{{tempMethods}}" wx:key="value" data-value="{{item.value}}" bindtap="setTempMethod">{{item.label}}</view>
    </view>

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitTemperature">{{editingId ? '保存修改' : '确定记录'}}</view>
  </view>

  <!-- ===== 吐奶弹窗 ===== -->
  <view class="mask" wx:if="{{showSpitUp}}" bindtap="closeSpitUp"></view>
  <view class="sheet" wx:if="{{showSpitUp}}">
    <view class="sheet-title">记录吐奶</view>
    <view class="sheet-close" bindtap="closeSpitUp">✕</view>

    <view class="sheet-label">吐了多少</view>
    <view class="diaper-options">
      <view class="diaper-opt {{spitUpLevel === 1 ? 'diaper-active' : ''}}" data-level="1" bindtap="setSpitUpLevel">
        <text class="diaper-emoji">💧</text>
        <text>少量</text>
      </view>
      <view class="diaper-opt {{spitUpLevel === 2 ? 'diaper-active' : ''}}" data-level="2" bindtap="setSpitUpLevel">
        <text class="diaper-emoji">🥛</text>
        <text>中量</text>
      </view>
      <view class="diaper-opt {{spitUpLevel === 3 ? 'diaper-active' : ''}}" data-level="3" bindtap="setSpitUpLevel">
        <text class="diaper-emoji">🍼</text>
        <text>大量</text>
      </view>
    </view>

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitSpitUp">{{editingId ? '保存修改' : '确定记录'}}</view>
  </view>

  <!-- ===== 洗澡弹窗 ===== -->
  <view class="mask" wx:if="{{showBath}}" bindtap="closeBath"></view>
  <view class="sheet" wx:if="{{showBath}}">
    <view class="sheet-title">记录洗澡</view>
    <view class="sheet-close" bindtap="closeBath">✕</view>

    <view class="sheet-label">洗了多久（分钟，可不填）</view>
    <view class="chips">
      <view class="chip {{bathDuration === item ? 'chip-active' : ''}}" wx:for="{{bathPresets}}" wx:key="*this" data-value="{{item}}" bindtap="setBathDuration">{{item}}</view>
      <view class="chip {{bathDuration === 0 ? 'chip-active' : ''}}" data-value="0" bindtap="setBathDuration">不记时长</view>
    </view>

    <view class="sheet-label">水温（℃，选填）</view>
    <input class="input" type="digit" placeholder="例如 38.0" value="{{bathWaterTemp}}" bindinput="onBathTempInput" />

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitBath">{{editingId ? '保存修改' : '确定记录'}}</view>
  </view>

  <!-- ===== 睡眠编辑弹窗 ===== -->
  <view class="mask" wx:if="{{showSleepEdit}}" bindtap="closeSleepEdit"></view>
  <view class="sheet" wx:if="{{showSleepEdit}}">
    <view class="sheet-title">编辑睡眠</view>
    <view class="sheet-close" bindtap="closeSleepEdit">✕</view>

    <view class="sheet-label">入睡时间</view>
    <picker mode="time" value="{{sleepStart}}" bindchange="onSleepStartChange">
      <view class="picker">{{sleepStart}}</view>
    </picker>

    <view class="sheet-label">起床时间</view>
    <picker mode="time" value="{{sleepEnd}}" bindchange="onSleepEndChange">
      <view class="picker">{{sleepEnd}}</view>
    </picker>

    <view class="sheet-tip">起床时间早于入睡时间时，会自动算作第二天</view>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitSleepEdit">保存修改</view>
  </view>

</view>
