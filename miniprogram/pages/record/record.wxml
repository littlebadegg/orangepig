<view class="page">

  <!-- ===== 宝宝栏 ===== -->
  <view class="baby-bar">
    <view class="row">
      <view class="baby-avatar">👶</view>
      <view class="col baby-meta">
        <text class="baby-name">{{currentBaby ? currentBaby.name : '还没有宝宝'}}</text>
        <text class="baby-sub">{{babySubtitle}}</text>
      </view>
    </view>
    <view class="switch-btn" bindtap="onSwitchBaby">切换</view>
  </view>

  <!-- ===== 今日概览 ===== -->
  <view class="card" wx:if="{{stats}}">
    <view class="card-title">今日概览</view>
    <view class="overview">
      <view class="ov-item">
        <view class="row">
          <text class="text-num">{{stats.feeding.count}}</text>
          <text class="text-unit">次</text>
        </view>
        <text class="ov-label">🍼 共 {{stats.feeding.totalAmount}}ml</text>
      </view>
      <view class="ov-item">
        <view class="row">
          <text class="text-num">{{stats.diaper.count}}</text>
          <text class="text-unit">次</text>
        </view>
        <text class="ov-label">🧷 便{{stats.diaper.pooCount}} 尿{{stats.diaper.peeCount}}</text>
      </view>
      <view class="ov-item">
        <view class="row">
          <text class="text-num">{{stats.sleep.count}}</text>
          <text class="text-unit">次</text>
        </view>
        <text class="ov-label">😴 {{stats.sleep.totalText}}</text>
      </view>
    </view>
    <view class="last-tip" wx:if="{{stats.feeding.lastFeeding}}">
      上次喂养 {{stats.feeding.lastFeeding.timeText}} · {{stats.feeding.lastFeeding.agoText}} · {{stats.feeding.lastFeeding.title}}
    </view>

    <!-- 第二行：排气操 / 体温 / 身高体重 -->
    <view class="overview overview-sub" wx:if="{{stats && (stats.exercise.count || stats.temperature.count || stats.growth.hasData)}}">
      <view class="ov-item">
        <view class="row">
          <text class="text-num">{{stats.exercise.count}}</text>
          <text class="text-unit">次</text>
        </view>
        <text class="ov-label">🤸 {{stats.exercise.minutesText || '—'}}</text>
      </view>
      <view class="ov-item">
        <text class="text-num text-sm">{{stats.temperature.latestText || '—'}}</text>
        <text class="ov-label">🌡️ {{stats.temperature.levelText}}</text>
      </view>
      <view class="ov-item">
        <text class="text-num text-sm">{{stats.growth.weightText || '—'}}</text>
        <text class="ov-label">📏 {{stats.growth.heightText || '未记录'}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 一键记录 ===== -->
  <view class="card">
    <view class="card-title">一键记录</view>
    <view class="actions">
      <view class="action action-feed" bindtap="openFeeding">
        <text class="action-icon">🍼</text>
        <text class="action-label">喂奶</text>
      </view>
      <view class="action action-diaper" bindtap="openDiaper">
        <text class="action-icon">🧷</text>
        <text class="action-label">换尿片</text>
      </view>
      <view class="action action-sleep {{ongoing ? 'action-active' : ''}}" bindtap="onSleepTap">
        <text class="action-icon">{{ongoing ? '🌞' : '😴'}}</text>
        <text class="action-label">{{ongoing ? '起床' : '睡觉'}}</text>
      </view>
    </view>
    <view class="actions actions-more">
      <view class="action action-exercise" bindtap="openExercise">
        <text class="action-icon">🤸</text>
        <text class="action-label">排气操</text>
      </view>
      <view class="action action-growth" bindtap="openGrowth">
        <text class="action-icon">📏</text>
        <text class="action-label">身高体重</text>
      </view>
      <view class="action action-temp" bindtap="openTemperature">
        <text class="action-icon">🌡️</text>
        <text class="action-label">体温</text>
      </view>
    </view>
    <view class="sleeping-tip" wx:if="{{ongoing}}">
      宝宝 {{ongoing.startText}} 入睡 · 已睡 {{sleepElapsed}}
    </view>
  </view>

  <!-- ===== 今日记录 ===== -->
  <view class="card">
    <view class="row-between">
      <text class="card-title">今日记录</text>
      <text class="text-sub">{{list.length}} 条</text>
    </view>

    <view class="empty" wx:if="{{list.length === 0}}">
      <text class="empty-icon">📝</text>
      <text>今天还没有记录，点上面的按钮记一条</text>
    </view>

    <view class="record-item" wx:for="{{list}}" wx:key="key">
      <view class="record-icon">{{item.icon}}</view>
      <view class="col record-main">
        <text class="record-title">{{item.title}}</text>
        <text class="record-sub" wx:if="{{item.kind === 'sleep'}}">{{item.subtitle}}</text>
        <text class="record-sub" wx:if="{{item.note}}">{{item.note}}</text>
      </view>
      <text class="record-time">{{item.timeText}}</text>
      <view class="record-del" data-kind="{{item.kind}}" data-id="{{item.id}}" bindtap="onDeleteRecord">✕</view>
    </view>
  </view>

  <!-- ===== 喂奶弹窗 ===== -->
  <view class="mask" wx:if="{{showFeeding}}" bindtap="closeFeeding"></view>
  <view class="sheet" wx:if="{{showFeeding}}">
    <view class="sheet-title">记录喂奶</view>
    <view class="sheet-close" bindtap="closeFeeding">✕</view>

    <view class="seg">
      <view class="seg-item {{feedingType === 'formula' ? 'seg-active' : ''}}" data-type="formula" bindtap="setFeedingType">奶粉</view>
      <view class="seg-item {{feedingType === 'breast' ? 'seg-active' : ''}}" data-type="breast" bindtap="setFeedingType">母乳</view>
    </view>

    <block wx:if="{{feedingType === 'formula'}}">
      <view class="sheet-label">奶量（ml）</view>
      <view class="chips">
        <view class="chip {{amount === item && !customAmount ? 'chip-active' : ''}}" wx:for="{{amountPresets}}" wx:key="*this" data-value="{{item}}" bindtap="setAmount">{{item}}</view>
      </view>
      <input class="input" type="number" placeholder="或输入自定义毫升数" value="{{customAmount}}" bindinput="onAmountInput" />
    </block>

    <block wx:else>
      <view class="sheet-label">喂奶时长（分钟）</view>
      <view class="chips">
        <view class="chip {{duration === item ? 'chip-active' : ''}}" wx:for="{{durationPresets}}" wx:key="*this" data-value="{{item}}" bindtap="setDuration">{{item}}</view>
      </view>
    </block>

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitFeeding">确定记录</view>
  </view>

  <!-- ===== 换尿片弹窗 ===== -->
  <view class="mask" wx:if="{{showDiaper}}" bindtap="closeDiaper"></view>
  <view class="sheet" wx:if="{{showDiaper}}">
    <view class="sheet-title">记录换尿片</view>
    <view class="sheet-close" bindtap="closeDiaper">✕</view>

    <view class="diaper-options">
      <view class="diaper-opt {{diaperType === 'pee' ? 'diaper-active' : ''}}" data-type="pee" bindtap="setDiaperType">
        <text class="diaper-emoji">💧</text>
        <text>小便</text>
      </view>
      <view class="diaper-opt {{diaperType === 'poo' ? 'diaper-active' : ''}}" data-type="poo" bindtap="setDiaperType">
        <text class="diaper-emoji">💩</text>
        <text>大便</text>
      </view>
      <view class="diaper-opt {{diaperType === 'both' ? 'diaper-active' : ''}}" data-type="both" bindtap="setDiaperType">
        <text class="diaper-emoji">💩💧</text>
        <text>都有</text>
      </view>
    </view>

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitDiaper">确定记录</view>
  </view>

  <!-- ===== 排气操弹窗 ===== -->
  <view class="mask" wx:if="{{showExercise}}" bindtap="closeExercise"></view>
  <view class="sheet" wx:if="{{showExercise}}">
    <view class="sheet-title">记录排气操</view>
    <view class="sheet-close" bindtap="closeExercise">✕</view>

    <view class="sheet-label">做了多久（分钟）</view>
    <view class="chips">
      <view class="chip {{exerciseDuration === item ? 'chip-active' : ''}}" wx:for="{{exercisePresets}}" wx:key="*this" data-value="{{item}}" bindtap="setExerciseDuration">{{item}}</view>
    </view>

    <view class="sheet-label">有排气 / 打嗝吗</view>
    <view class="seg">
      <view class="seg-item {{exerciseResult === 1 ? 'seg-active' : ''}}" data-value="1" bindtap="setExerciseResult">有</view>
      <view class="seg-item {{exerciseResult === 2 ? 'seg-active' : ''}}" data-value="2" bindtap="setExerciseResult">没有</view>
      <view class="seg-item {{exerciseResult === 0 ? 'seg-active' : ''}}" data-value="0" bindtap="setExerciseResult">不记</view>
    </view>

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitExercise">确定记录</view>
  </view>

  <!-- ===== 身高体重弹窗 ===== -->
  <view class="mask" wx:if="{{showGrowth}}" bindtap="closeGrowth"></view>
  <view class="sheet" wx:if="{{showGrowth}}">
    <view class="sheet-title">记录身高体重</view>
    <view class="sheet-close" bindtap="closeGrowth">✕</view>

    <view class="sheet-tip">两个都填或只填一个都可以</view>

    <view class="sheet-label">身高（cm）</view>
    <input class="input" type="digit" placeholder="例如 64.0" value="{{height}}" bindinput="onHeightInput" />

    <view class="sheet-label">体重（kg）</view>
    <input class="input" type="digit" placeholder="例如 7.2" value="{{weight}}" bindinput="onWeightInput" />

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitGrowth">确定记录</view>
  </view>

  <!-- ===== 体温弹窗 ===== -->
  <view class="mask" wx:if="{{showTemperature}}" bindtap="closeTemperature"></view>
  <view class="sheet" wx:if="{{showTemperature}}">
    <view class="sheet-title">记录体温</view>
    <view class="sheet-close" bindtap="closeTemperature">✕</view>

    <view class="sheet-label">体温（℃）</view>
    <view class="chips">
      <view class="chip {{temperature === item && !customTemperature ? 'chip-active' : ''}}" wx:for="{{tempPresets}}" wx:key="*this" data-value="{{item}}" bindtap="setTemperature">{{item}}</view>
    </view>
    <input class="input" type="digit" placeholder="或输入精确体温，例如 36.9" value="{{customTemperature}}" bindinput="onTempInput" />

    <view class="sheet-label">测量方式</view>
    <view class="seg">
      <view class="seg-item {{tempMethod === item.value ? 'seg-active' : ''}}" wx:for="{{tempMethods}}" wx:key="value" data-value="{{item.value}}" bindtap="setTempMethod">{{item.label}}</view>
    </view>

    <view class="sheet-label">时间</view>
    <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
      <view class="picker">{{timeValue}}</view>
    </picker>

    <view class="btn btn-primary btn-block sheet-btn" bindtap="submitTemperature">确定记录</view>
  </view>

</view>
