/* ===== 首页：一键记录 ===== */
.page {
  padding-bottom: 60rpx;
}

/* 宝宝栏 */
.baby-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #ffa25c, #ff7a45);
  padding: 36rpx 32rpx calc(48rpx);
  color: #fff;
}

.baby-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.baby-meta {
  justify-content: center;
}

.baby-name {
  font-size: 36rpx;
  font-weight: 600;
}

.baby-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.switch-btn {
  background: rgba(255, 255, 255, 0.22);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 概览 */
.overview {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.ov-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ov-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}

.last-tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #fff8f2;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #c1683c;
}

/* 一键记录按钮 */
.actions {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.action {
  flex: 1;
  margin: 0 10rpx;
  padding: 32rpx 0;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
}

.action-icon {
  font-size: 56rpx;
  line-height: 1;
}

.action-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 12rpx;
  color: #333;
}

.action-feed {
  background: #fff3e6;
  border-color: #ffd6b0;
}

.action-diaper {
  background: #e8fbf8;
  border-color: #b6ece5;
}

.action-sleep {
  background: #efeeff;
  border-color: #d2cfff;
}

.action-active {
  background: #ffe9df;
  border-color: #ff9a6c;
}

.sleeping-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ff7a45;
  background: #fff3ec;
  padding: 16rpx;
  border-radius: 12rpx;
}

/* 记录列表 */
.record-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon {
  font-size: 40rpx;
  width: 64rpx;
  text-align: center;
}

.record-main {
  flex: 1;
  margin-left: 8rpx;
}

.record-title {
  font-size: 30rpx;
  color: #222;
}

.record-sub {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 2rpx;
}

.record-time {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.record-del {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f7f7f7;
  color: #bbb;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗控件 */
.seg {
  display: flex;
  flex-direction: row;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 10rpx;
}

.seg-active {
  background: #fff;
  color: #ff7a45;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.sheet-label {
  font-size: 26rpx;
  color: #888;
  margin: 20rpx 0 14rpx;
}

.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.chip {
  padding: 14rpx 30rpx;
  background: #f2f3f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #555;
  margin: 0 16rpx 16rpx 0;
}

.chip-active {
  background: #ff7a45;
  color: #fff;
  font-weight: 600;
}

.input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.picker {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #333;
}

.sheet-btn {
  margin-top: 32rpx;
  padding: 26rpx 0;
  font-size: 32rpx;
}

/* 换尿片选项 */
.diaper-options {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.diaper-opt {
  flex: 1;
  margin: 0 10rpx;
  padding: 32rpx 0;
  background: #f7f8fa;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 28rpx;
  color: #555;
  border: 2rpx solid transparent;
}

.diaper-emoji {
  font-size: 52rpx;
  margin-bottom: 10rpx;
}

.diaper-active {
  background: #fff3e6;
  border-color: #ff7a45;
  color: #ff7a45;
  font-weight: 600;
}
