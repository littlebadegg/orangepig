/* ===== 首页：一键记录 ===== */
.page {
  padding-bottom: 60rpx;
}

/* 宝宝栏 */
.baby-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #ffa25c, #ff7a45);
  padding: 36rpx 32rpx calc(48rpx);
  color: #fff;
}

.baby-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.baby-meta {
  justify-content: center;
}

.baby-name {
  font-size: 36rpx;
  font-weight: 600;
}

.baby-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.switch-btn {
  background: rgba(255, 255, 255, 0.22);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 概览 */
.overview {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.ov-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ov-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}

.last-tip {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #fff8f2;
  border-radius: 12rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.tip-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tip-ago {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff7a45;
}

.tip-detail {
  font-size: 22rpx;
  color: #b58b6f;
  margin-top: 2rpx;
}

/* 超过 3 小时没换尿片：变色提醒 */
.last-tip-warn {
  background: #fff1f0;
}

.last-tip-warn .tip-ago {
  color: #e34d59;
}

.last-tip-warn .tip-detail {
  color: #c98a86;
}

/* 一键记录按钮 */
.actions {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.action {
  flex: 1;
  margin: 0 10rpx;
  padding: 32rpx 0;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
}

.action-icon {
  font-size: 56rpx;
  line-height: 1;
}

.action-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 12rpx;
  color: #333;
}

/* 点击反馈：能一眼看出事件有没有被触发 */
.action-hover {
  opacity: 0.7;
}

.action-feed {
  background: #fff3e6;
  border-color: #ffd6b0;
}

.action-diaper {
  background: #e8fbf8;
  border-color: #b6ece5;
}

.action-sleep {
  background: #efeeff;
  border-color: #d2cfff;
}

.action-active {
  background: #ffe9df;
  border-color: #ff9a6c;
}

.sleeping-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ff7a45;
  background: #fff3ec;
  padding: 16rpx;
  border-radius: 12rpx;
}

/* 记录列表 */
.record-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon {
  font-size: 40rpx;
  width: 64rpx;
  text-align: center;
}

.record-main {
  flex: 1;
  margin-left: 8rpx;
}

.record-title {
  font-size: 30rpx;
  color: #222;
}

.record-sub {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 2rpx;
}

.record-time {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.record-del {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f7f7f7;
  color: #bbb;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗控件 */
.seg {
  display: flex;
  flex-direction: row;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 10rpx;
}

.seg-active {
  background: #fff;
  color: #ff7a45;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.sheet-label {
  font-size: 26rpx;
  color: #888;
  margin: 20rpx 0 14rpx;
}

.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.chip {
  padding: 14rpx 30rpx;
  background: #f2f3f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #555;
  margin: 0 16rpx 16rpx 0;
}

.chip-active {
  background: #ff7a45;
  color: #fff;
  font-weight: 600;
}

.input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.picker {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #333;
}

.sheet-btn {
  margin-top: 32rpx;
  padding: 26rpx 0;
  font-size: 32rpx;
}

/* 第二行按钮 */
.actions-more {
  margin-top: 20rpx;
}

.action-spitup {
  background: #fff0e0;
  border-color: #ffd39b;
}

.action-bath {
  background: #e6f6ff;
  border-color: #b3e2ff;
}

.action-exercise {
  background: #eef9e9;
  border-color: #c9eec0;
}

.action-growth {
  background: #eaf3ff;
  border-color: #c2dcff;
}

.action-temp {
  background: #fdeef0;
  border-color: #fbcdd5;
}

/* 概览第二行 */
.overview-sub {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #eee;
}

/* 数值类文字（体温、体重这种带单位的，字号要小一点） */
.text-sm {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

/* 最近一次身高体重（单独一行，不跟四个计数挤在一起） */
.growth-line {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #eee;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.growth-item {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-right: 32rpx;
}

.growth-date {
  font-size: 24rpx;
  color: #aaa;
  margin-left: auto;
}

/* 记录人：家人一起记的时候显示这条是谁录的 */
.record-by {
  font-size: 22rpx;
  color: #ff9a6c;
  margin-top: 4rpx;
}

/* 评分入口（标题右侧） */
.score-link {
  font-size: 24rpx;
  color: #ff7a45;
}

/* 弹窗里的说明文字 */
.sheet-tip {
  font-size: 24rpx;
  color: #aaa;
  margin-bottom: 8rpx;
}

/* 换尿片选项 */
.diaper-options {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.diaper-opt {
  flex: 1;
  margin: 0 10rpx;
  padding: 32rpx 0;
  background: #f7f8fa;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 28rpx;
  color: #555;
  border: 2rpx solid transparent;
}

.diaper-emoji {
  font-size: 52rpx;
  margin-bottom: 10rpx;
}

.diaper-active {
  background: #fff3e6;
  border-color: #ff7a45;
  color: #ff7a45;
  font-weight: 600;
}

/* ===== 今日养育评分 ===== */
.score-card {
  background: linear-gradient(180deg, #fff8f2 0%, #ffffff 42%);
}

.score-level {
  font-size: 24rpx;
  color: #ff7a45;
  background: #fff1e8;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.score-main {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin: 8rpx 0 20rpx;
}

.score-total {
  font-size: 88rpx;
  font-weight: 700;
  color: #ff7a45;
  line-height: 1;
}

.score-unit {
  font-size: 28rpx;
  color: #ff7a45;
  margin-left: 6rpx;
}

.score-sub {
  font-size: 22rpx;
  color: #999;
  margin-left: 16rpx;
}

.score-item {
  margin-bottom: 18rpx;
}

.score-item-label {
  font-size: 26rpx;
  color: #444;
}

.score-item-score {
  font-size: 24rpx;
  color: #999;
}

.score-bar {
  height: 10rpx;
  background: #f2f2f2;
  border-radius: 999rpx;
  margin: 8rpx 0 6rpx;
  overflow: hidden;
}

.score-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffb07a, #ff7a45);
  border-radius: 999rpx;
}

.score-item-detail {
  font-size: 22rpx;
  color: #aaa;
}

.score-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.score-tag {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin: 6rpx 12rpx 0 0;
}

.tag-bonus {
  color: #2f9e44;
  background: #ebfbee;
}

.tag-penalty {
  color: #e34d59;
  background: #fff0f1;
}

.score-tips {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.score-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.7;
}

/* 记录项点击反馈 */
.record-hover {
  background: #fafafa;
}

/* ===== 记录折叠 ===== */
.record-toggle {
  margin-top: 20rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #ff7a45;
  background: #fff8f2;
  border-radius: 12rpx;
}

.toggle-arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
}

/* ===== 喂水 / 喂养品按钮 ===== */
.action-water {
  background: #e8f7ff;
  border-color: #b8e6ff;
}

.action-supplement {
  background: #f3efff;
  border-color: #d8ccff;
}

/* ===== 今日醒目提醒 ===== */
.remind-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 0 24rpx 20rpx;
}

.remind-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #fff7e6;
  border: 1rpx solid #ffe1a8;
}

.remind-urgent {
  background: #fff1f0;
  border-color: #ffccc7;
}

.remind-icon {
  font-size: 34rpx;
  margin-right: 14rpx;
}

.remind-text {
  flex: 1;
  font-size: 27rpx;
  font-weight: 600;
  color: #d46b08;
}

.remind-urgent .remind-text {
  color: #e34d59;
}

.remind-btn {
  font-size: 25rpx;
  color: #ff7a45;
  font-weight: 600;
  margin-left: 12rpx;
}

.remind-hover {
  opacity: 0.8;
}

/* ===== 日期切换 ===== */
.date-row {
  gap: 16rpx;
}

.date-picker {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.date-arrow {
  margin-left: 10rpx;
  font-size: 26rpx;
}

.back-today {
  font-size: 24rpx;
  color: #fff;
  background: #ff7a45;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
}

/* ===== 养育小贴士 ===== */
.tips-card .toggle-arrow {
  color: #ff7a45;
}

.tips-preview {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #b58b6f;
}

.tips-group {
  margin-top: 24rpx;
}

.tips-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff9a5c;
  margin-bottom: 12rpx;
}

.tips-item {
  background: #fff8f2;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: column;
}

.tips-item-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6d4c33;
}

.tips-item-content {
  font-size: 24rpx;
  color: #8a7462;
  line-height: 1.6;
  margin-top: 6rpx;
}

.tips-source {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #c0a896;
}

/* ===== 自定义喂养项管理 ===== */
.custom-manage {
  margin-top: 24rpx;
  border-top: 1rpx solid #f0e6dc;
  padding-top: 16rpx;
}

.custom-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 8rpx;
  font-size: 26rpx;
  color: #6d4c33;
}

.custom-del {
  font-size: 24rpx;
  color: #e34d59;
}

/* ===== 游客欢迎横幅 ===== */
.guest-banner {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff7ef;
  border: 1rpx solid #ffd9b8;
}

.guest-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.guest-emoji {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.guest-text {
  flex: 1;
  font-size: 26rpx;
  color: #8a5b33;
  line-height: 1.6;
}

.guest-login-btn {
  margin-top: 18rpx;
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: #ff7a45;
  border-radius: 38rpx;
  padding: 0;
}

.guest-login-btn::after {
  border: none;
}
