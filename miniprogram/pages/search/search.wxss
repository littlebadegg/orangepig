/* 相册页样式 */
.album-page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 40rpx;
}

/* 顶部 Tab */
.album-tabs {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  height: 88rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  font-size: 28rpx;
  color: #999;
  padding: 12rpx 0;
  margin-right: 48rpx;
  position: relative;
}

.tab-item.active {
  color: #FF6B35;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #FF6B35;
  border-radius: 2rpx;
}

.tab-spacer {
  flex: 1;
}

.upload-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 28rpx;
  background: #FF6B35;
  border-radius: 32rpx;
}

.upload-icon {
  font-size: 32rpx;
  color: #fff;
  font-weight: 300;
}

.upload-text {
  font-size: 26rpx;
  color: #fff;
}

/* 照片统计 */
.photo-summary {
  padding: 20rpx 30rpx 10rpx;
}

.summary-text {
  font-size: 24rpx;
  color: #999;
}

/* 加载骨架 */
.loading-state {
  padding: 30rpx;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}

.skeleton-item {
  width: calc((100% - 8rpx) / 3);
  height: 240rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #ccc;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 48rpx;
  background: #FF6B35;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 分组 */
.photo-groups {
  padding: 0 30rpx;
}

.photo-group,
.location-group {
  margin-top: 30rpx;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.group-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.group-location {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.group-count {
  font-size: 24rpx;
  color: #999;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}

.photo-item {
  width: calc((100% - 8rpx) / 3);
  height: 240rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
}

.photo-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 12rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
}

.photo-location {
  font-size: 20rpx;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
