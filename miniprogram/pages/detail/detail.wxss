.detail-page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 120rpx;
}

.author-bar {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #fff;
  margin-bottom: 2rpx;
}

.author-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.author-text {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.author-time {
  font-size: 22rpx;
  color: #bbb;
}

.follow-btn {
  padding: 12rpx 32rpx;
  background: #FF6B35;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
}

.follow-btn.followed {
  background: #f5f5f5;
  color: #999;
}

.post-content {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 2rpx;
}

.content-text {
  font-size: 32rpx;
  color: #1a1a1a;
  line-height: 1.8;
  display: block;
  margin-bottom: 20rpx;
}

.post-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-item.liked .action-icon {
  color: #FF6B35;
}

.action-icon {
  font-size: 36rpx;
}

.action-count {
  font-size: 26rpx;
  color: #888;
}

.share-btn {
  background: none;
  border: none;
  padding: 0;
  line-height: normal;
}

.share-btn::after {
  border: none;
}

.comments-section {
  background: #fff;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.comment-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.comment-name {
  font-size: 26rpx;
  color: #576B95;
  margin-bottom: 8rpx;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #bbb;
}

.no-comments {
  text-align: center;
  padding: 60rpx 0;
  color: #ccc;
  font-size: 26rpx;
}

.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  padding: 16rpx 32rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.loading-page {
  padding: 30rpx;
}

.skeleton-block {
  height: 200rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.skeleton-block.short {
  height: 80rpx;
  width: 60%;
}
