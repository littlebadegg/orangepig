<!-- 内容详情页 -->
<view class="detail-page" wx:if="{{post}}">
  <!-- 作者信息 -->
  <view class="author-bar">
    <view class="author-info" bindtap="onTapAuthor">
      <image class="author-avatar" src="{{post.author.avatarUrl}}" mode="aspectFill"></image>
      <view class="author-text">
        <text class="author-name">{{post.author.nickName}}</text>
        <text class="author-time">{{post.timeText}}</text>
      </view>
    </view>
    <view
      class="follow-btn {{post.isFollowing ? 'followed' : ''}}"
      wx:if="{{!post.isMine}}"
      bindtap="onToggleFollow"
    >{{post.isFollowing ? '已关注' : '+ 关注'}}</view>
  </view>

  <!-- 内容正文 -->
  <view class="post-content">
    <text class="content-text">{{post.content}}</text>
    <block wx:for="{{post.images}}" wx:key="*this">
      <image
        class="post-image"
        src="{{item}}"
        mode="widthFix"
        lazy-load
        bindtap="previewImage"
        data-url="{{item}}"
      ></image>
    </block>
  </view>

  <!-- 互动栏 -->
  <view class="action-bar">
    <view class="action-item {{post.liked ? 'liked' : ''}}" bindtap="onToggleLike">
      <text class="action-icon">{{post.liked ? '❤' : '♡'}}</text>
      <text class="action-count">{{post.likeCountText}}</text>
    </view>
    <view class="action-item" bindtap="toggleCommentInput">
      <text class="action-icon">💬</text>
      <text class="action-count">{{post.commentCountText}}</text>
    </view>
    <button class="action-item share-btn" open-type="share">
      <text class="action-icon">↗</text>
      <text class="action-count">分享</text>
    </button>
  </view>

  <!-- 评论列表 -->
  <view class="comments-section">
    <view class="section-title">评论 {{post.commentCountText}}</view>

    <view
      wx:for="{{comments}}"
      wx:key="id"
      class="comment-item"
    >
      <image class="comment-avatar" src="{{item.author.avatarUrl}}" mode="aspectFill"></image>
      <view class="comment-body">
        <text class="comment-name">{{item.author.nickName}}</text>
        <text class="comment-text">{{item.content}}</text>
        <text class="comment-time">{{item.timeText}}</text>
      </view>
    </view>

    <view class="no-comments" wx:if="{{comments.length === 0}}">
      <text>还没有评论，快来抢沙发</text>
    </view>
  </view>

  <!-- 底部评论输入框 -->
  <view class="comment-bar safe-bottom" wx:if="{{showCommentInput}}">
    <input
      class="comment-input"
      placeholder="写评论..."
      value="{{commentText}}"
      bindinput="onCommentInput"
      confirm-type="send"
      bindconfirm="onSubmitComment"
      focus="{{showCommentInput}}"
    />
    <view class="send-btn" bindtap="onSubmitComment">发送</view>
  </view>
</view>

<!-- 加载中骨架 -->
<view class="loading-page" wx:if="{{loading}}">
  <view class="skeleton-block"></view>
  <view class="skeleton-block"></view>
  <view class="skeleton-block short"></view>
</view>
