.doc-page {
  padding: 40rpx 44rpx 80rpx;
  background: #ffffff;
  min-height: 100vh;
  box-sizing: border-box;
}

.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
  text-align: center;
}

.doc-updated {
  margin-top: 12rpx;
  margin-bottom: 32rpx;
  font-size: 22rpx;
  color: #aaa;
  text-align: center;
}

.doc-section {
  margin-bottom: 36rpx;
}

.doc-h {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
}

.doc-p {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 12rpx;
  text-align: justify;
}
