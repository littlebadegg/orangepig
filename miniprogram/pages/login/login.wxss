.login-page {
  min-height: 100vh;
  padding: 120rpx 56rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #fff4ec 0%, #ffffff 46%);
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  text-align: center;
  font-size: 88rpx;
  background: #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 122, 69, 0.18);
}

.login-title {
  margin-top: 36rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #222;
  letter-spacing: 2rpx;
}

.login-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #999;
}

.login-features {
  width: 100%;
  margin-top: 72rpx;
}

.feature {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 28rpx;
  margin-bottom: 18rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.feature-icon {
  font-size: 36rpx;
  margin-right: 18rpx;
}

.feature-text {
  font-size: 26rpx;
  color: #555;
}

.login-actions {
  width: 100%;
  margin-top: auto;
  padding-top: 60rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: #ff7a45;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.login-btn::after {
  border: none;
}

.agree-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
}

.agree-box {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #ffffff;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  margin-right: 12rpx;
  box-sizing: border-box;
}

.agree-on {
  background: #ff7a45;
  border-color: #ff7a45;
}

.agree-text {
  font-size: 22rpx;
  color: #999;
}
