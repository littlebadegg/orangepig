.page {
  padding: 24rpx 24rpx 48rpx;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

/* ===== 总分卡 ===== */
.score-hero {
  background: linear-gradient(135deg, #ff8a5c 0%, #ff7a45 60%, #ff6a2e 100%);
  color: #ffffff;
}

.hero-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.hero-title {
  font-size: 28rpx;
  opacity: 0.92;
}

.hero-level {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.22);
}

.hero-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 28rpx;
}

.hero-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 6rpx solid rgba(255, 255, 255, 0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-total {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.hero-unit {
  font-size: 22rpx;
  margin-top: 6rpx;
  opacity: 0.9;
}

.hero-side {
  flex: 1;
  margin-left: 40rpx;
}

.hero-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 26rpx;
  padding: 10rpx 0;
  opacity: 0.95;
}

.hero-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.dot-base {
  background: #ffffff;
}

.dot-bonus {
  background: #ffe3b3;
}

.dot-penalty {
  background: #b9e2ff;
}

.hero-val {
  margin-left: auto;
  font-weight: 600;
}

.val-bonus {
  color: #fff3d6;
}

.val-penalty {
  color: #d8efff;
}

/* ===== 各维度 ===== */
.dim-item {
  padding: 18rpx 0;
}

.dim-label {
  font-size: 28rpx;
  color: #333;
}

.dim-score {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff7a45;
}

.dim-full {
  color: #2fb56b;
}

.dim-max {
  font-size: 22rpx;
  font-weight: 400;
  color: #bbb;
}

.dim-bar {
  height: 12rpx;
  background: #f2f3f5;
  border-radius: 6rpx;
  margin: 10rpx 0 8rpx;
  overflow: hidden;
}

.dim-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #ffa576, #ff7a45);
}

.dim-detail {
  font-size: 22rpx;
  color: #999;
}

/* ===== 加减分 ===== */
.tag-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.score-tag {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  margin: 0 14rpx 14rpx 0;
}

.tag-bonus {
  color: #2e9e5b;
  background: #eaf9f0;
}

.tag-penalty {
  color: #e34d59;
  background: #fdeeee;
}

/* ===== 建议 / 规则 ===== */
.tip {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.9;
}

.rules-card {
  margin-top: 8rpx;
}

.rule-line {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.9;
}
